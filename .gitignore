# .NET
bin/
obj/
*.user
*.suo
testresults/
TestResults/

# Local package bootstrap feed (regenerable via node artifacts/fetch-nuget.js);
# the .gitkeep placeholder IS tracked so fresh clones keep the folder for nuget.config.
artifacts/nuget-feed/*
!artifacts/nuget-feed/.gitkeep
artifacts/nuget-packages/
# Scratch files
artifacts/*.txt
artifacts/*.json
artifacts/*.log

# Local databases / app data
*.db
*.db-shm
*.db-wal
backend/.localdata/

# Node / frontend
node_modules/
frontend/oniDash.Web/dist/
frontend/oniDash.Web/coverage/
# Verification screenshots (regenerated by the scripts)
artifacts/visual/shots/

# Built assets copied into the API for SPA hosting (deployment artifact)
backend/oniDash.Api/wwwroot/

# IDE / OS
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store

# Env / secrets
.env
.env.*
gitcred.txt
*_device.json
