<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The local feed (artifacts/nuget-feed) makes restricted/offline development environments
    work without nuget.org access. It is a bootstrap cache; nuget.org remains the authoritative
    source for anything not present locally. See docs/DEVELOPMENT (offline NuGet bootstrap).
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="artifacts\nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Keep the package cache inside the repository (gitignored via artifacts/) so the
       solution restores self-contained on machines with restricted user-profile access. -->
  <config>
    <add key="globalPackagesFolder" value="artifacts\nuget-packages" />
  </config>
</configuration>
